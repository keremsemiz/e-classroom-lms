# Database - Use Turso (SQLite-compatible) for Vercel
# Get free database at https://turso.tech
DATABASE_URL="libsql://your-database.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Or use Neon (PostgreSQL) - https://neon.tech
# DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# Auth Secrets (generate new ones for production)
JWT_SECRET="generate-a-new-secret-here"
NEXTAUTH_SECRET="generate-another-secret-here"
NEXTAUTH_URL="https://e-classroom.smzedu.com"
