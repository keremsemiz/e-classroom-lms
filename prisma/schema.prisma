// E-Classroom LMS - SMZ Education
// Complete Database Schema

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE ENTITIES
// ============================================

/// School - Multi-tenant organization
model School {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  domain      String?
  logo        String?
  address     String?
  phone       String?
  email       String?
  website     String?
  description String?
  settings    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       User[]
  classes     Class[]
  admins      User[]   @relation("SchoolAdmins")

  @@index([code])
  @@index([isActive])
}

/// User - All platform users with role-based access
model User {
  id            String      @id @default(cuid())
  email         String      @unique
  password      String
  name          String
  role          UserRole    @default(STUDENT)
  schoolId      String?
  avatar        String?
  phone         String?
  bio           String?
  dateOfBirth   DateTime?
  address       String?
  isActive      Boolean     @default(true)
  isVerified    Boolean     @default(false)
  lastLogin     DateTime?
  preferences   Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  school        School?     @relation(fields: [schoolId], references: [id])
  adminOf       School[]    @relation("SchoolAdmins")
  taughtClasses Class[]     @relation("ClassTeacher")
  enrollments   Enrollment[]
  submissions   Submission[]
  gradesGiven   Grade[]     @relation("GradedBy")
  gradesReceived Grade[]    @relation("GradeStudent")
  attendance    Attendance[] @relation("StudentAttendance")
  recordedAttendance Attendance[] @relation("RecordedBy")
  sentMessages  Message[]   @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")
  announcements Announcement[]
  notifications Notification[]
  uploadedFiles File[]
  sessions      Session[]

  @@index([email])
  @@index([schoolId])
  @@index([role])
  @@index([isActive])
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

// ============================================
// CLASS MANAGEMENT
// ============================================

/// Class - Course/Classroom entity
model Class {
  id               String        @id @default(cuid())
  name             String
  code             String        @unique
  description      String?
  subject          String?
  gradeLevel       String?
  academicYear     String?
  room             String?
  schedule         String?
  coverImage       String?
  color            String        @default("#3B82F6")
  teacherId        String
  schoolId         String?
  isActive         Boolean       @default(true)
  allowStudentPosts Boolean      @default(true)
  allowStudentChat Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  teacher          User          @relation("ClassTeacher", fields: [teacherId], references: [id])
  school           School?       @relation(fields: [schoolId], references: [id])
  enrollments      Enrollment[]
  assignments      Assignment[]
  announcements    Announcement[]
  schedules        Schedule[]
  attendance       Attendance[]

  @@index([code])
  @@index([teacherId])
  @@index([schoolId])
  @@index([isActive])
}

/// Enrollment - Student enrollment in classes
model Enrollment {
  id          String        @id @default(cuid())
  classId     String
  studentId   String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime      @default(now())
  droppedAt   DateTime?

  // Relations
  class       Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
  @@index([status])
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
  SUSPENDED
}

/// Schedule - Class schedule/timetable
model Schedule {
  id          String    @id @default(cuid())
  classId     String
  dayOfWeek   Int       // 0 = Sunday, 1 = Monday, etc.
  startTime   String    // HH:mm format
  endTime     String    // HH:mm format
  room        String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([dayOfWeek])
}

// ============================================
// ASSIGNMENTS & SUBMISSIONS
// ============================================

/// Assignment - Homework, quiz, project, etc.
model Assignment {
  id                  String            @id @default(cuid())
  classId             String
  title               String
  description         String?
  instructions        String?
  assignmentType      AssignmentType    @default(HOMEWORK)
  points              Float             @default(100)
  dueDate             DateTime?
  allowLateSubmission Boolean           @default(false)
  latePenalty         Float?            // Percentage penalty
  maxAttempts         Int               @default(1)
  attachments         Json?             // Array of file paths
  rubric              Json?             // Grading rubric
  status              AssignmentStatus  @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relations
  class               Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions         Submission[]
  grades              Grade[]

  @@index([classId])
  @@index([dueDate])
  @@index([status])
  @@index([assignmentType])
}

enum AssignmentType {
  HOMEWORK
  QUIZ
  TEST
  PROJECT
  ESSAY
  PRESENTATION
  DISCUSSION
  OTHER
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

/// Submission - Student submission for assignment
model Submission {
  id              String          @id @default(cuid())
  assignmentId    String
  studentId       String
  content         String?
  attachments     Json?           // Array of file paths
  submittedAt     DateTime        @default(now())
  attemptNumber   Int             @default(1)
  status          SubmissionStatus @default(SUBMITTED)
  late            Boolean         @default(false)
  resubmittedAt   DateTime?
  gradeId         String?         @unique

  // Relations
  assignment      Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student         User            @relation(fields: [studentId], references: [id])
  grade           Grade?

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@index([submittedAt])
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  RETURNED
  GRADED
  RESUBMIT
}

// ============================================
// GRADING
// ============================================

/// Grade - Grade record for submissions
model Grade {
  id              String    @id @default(cuid())
  submissionId    String    @unique
  assignmentId    String
  studentId       String
  score           Float
  maxScore        Float     @default(100)
  percentage      Float?
  letterGrade     String?
  feedback        String?
  rubricScores    Json?
  gradedBy        String
  gradedAt        DateTime  @default(now())
  isFinal         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  submission      Submission @relation(fields: [submissionId], references: [id])
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  grader          User      @relation("GradedBy", fields: [gradedBy], references: [id])
  student         User      @relation("GradeStudent", fields: [studentId], references: [id])

  @@index([assignmentId])
  @@index([studentId])
  @@index([gradedBy])
  @@index([gradedAt])
}

// ============================================
// ATTENDANCE
// ============================================

/// Attendance - Daily attendance records
model Attendance {
  id          String          @id @default(cuid())
  classId     String
  studentId   String
  date        DateTime
  status      AttendanceStatus @default(PRESENT)
  checkInTime String?
  notes       String?
  recordedBy  String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  class       Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  student     User            @relation("StudentAttendance", fields: [studentId], references: [id])
  recorder    User            @relation("RecordedBy", fields: [recordedBy], references: [id])

  @@unique([classId, studentId, date])
  @@index([classId])
  @@index([studentId])
  @@index([date])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  EARLY_DISMISSAL
}

// ============================================
// COMMUNICATION
// ============================================

/// Message - Direct messaging between users
model Message {
  id          String      @id @default(cuid())
  senderId    String
  receiverId  String
  subject     String?
  content     String
  read        Boolean     @default(false)
  readAt      DateTime?
  archived    Boolean     @default(false)
  starred     Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  sender      User        @relation("MessageSender", fields: [senderId], references: [id])
  receiver    User        @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([read])
  @@index([createdAt])
}

/// Announcement - Class/School announcements
model Announcement {
  id          String    @id @default(cuid())
  classId     String?
  authorId    String
  title       String
  content     String
  priority    Int       @default(0)  // Higher = more important
  pinned      Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  class       Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id])

  @@index([classId])
  @@index([authorId])
  @@index([createdAt])
  @@index([pinned])
}

/// Notification - User notifications
model Notification {
  id          String            @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  link        String?
  read        Boolean           @default(false)
  readAt      DateTime?
  createdAt   DateTime          @default(now())

  // Relations
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([type])
}

enum NotificationType {
  ASSIGNMENT
  GRADE
  ANNOUNCEMENT
  MESSAGE
  ATTENDANCE
  REMINDER
  SYSTEM
}

// ============================================
// FILES & STORAGE
// ============================================

/// File - Uploaded files
model File {
  id          String    @id @default(cuid())
  name        String
  originalName String
  path        String
  size        Int
  mimeType    String
  category    String?
  uploadedBy  String
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // Relations
  uploader    User      @relation(fields: [uploadedBy], references: [id])

  @@index([uploadedBy])
  @@index([category])
}

// ============================================
// SESSIONS & AUTH
// ============================================

/// Session - User sessions for authentication
model Session {
  id          String    @id @default(cuid())
  userId      String
  token       String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}
